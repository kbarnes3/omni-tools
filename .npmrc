# npm 12 blocks URL/tarball dependencies by default (allow-remote=none).
# `xlsx` is pulled in transitively by the `locize-cli` devDependency and is
# pinned to https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz, so installs
# fail with EALLOWREMOTE. `root` is not enough because the dependency is not
# declared in our own package.json.
allow-remote=all
